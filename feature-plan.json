{
  "schema_version": 1,
  "current_feature": "core-skeleton",
  "features": [
    {
      "id": "core-skeleton",
      "title": "Core FastAPI/React skeleton with model listing and chat",
      "status": "done",
      "acceptance": [
        "FastAPI backend starts and serves /v1/models endpoint",
        "React frontend builds and loads",
        "Frontend can list available models from backend",
        "Frontend can send chat completion request and receive response",
        "SQLite persistence for models and API keys",
        "Docker compose for local development"
      ],
      "implementation": [
        "backend/app/main.py",
        "backend/app/api/routes.py",
        "backend/app/services/router.py",
        "backend/app/models/schema.py",
        "backend/requirements.txt",
        "frontend/package.json",
        "frontend/src/main.tsx",
        "frontend/src/App.tsx",
        "frontend/src/api/client.ts",
        "docker-compose.yaml",
        "README.md"
      ],
      "tests": [
        "backend/tests/test_routes.py",
        "backend/tests/test_router.py",
        "frontend/src/App.test.tsx"
      ]
    },
    {
      "id": "smart-routing",
      "title": "Smart routing with failover and per-key concurrency",
      "status": "planned",
      "acceptance": [
        "Router selects healthy keys per platform",
