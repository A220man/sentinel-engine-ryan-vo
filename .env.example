# Sentinel Engine Configuration
# Copy to .env and fill in your values

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db

# Encryption key for API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# LLM Provider defaults for probing
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Probing settings
PROBE_INTERVAL_SEC=300
PROBE_TIMEOUT_SEC=30
PROBE_ENABLED=true

# Routing settings
MAX_CONCURRENT_PER_KEY=10
HEDGE_AFTER_MS=5000
DEFAULT_TIMEOUT_SEC=60

# Keycloak/OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-frontend
KEYCLOAK_CLIENT_SECRET=sentinel-frontend-secret
OIDC_ISSUER=http://localhost:8080/realms/sentinel
OIDC_AUDIENCE=sentinel-api

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Demo mode (localhost only, refuses to start in production without SENTINEL_DEMO_ALLOWED=1)
DEMO_MODE=false
SENTINEL_DEMO_ALLOWED=0